{
  "name": "novabank-banking-system",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack simulated retail banking system built as the application under test for the qa-banking-system QA portfolio.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "smoke": "node scripts/smoke.js",
    "check": "node --check server.js && node --check src/app.js && node --check src/banking.js && node --check src/database.js",
    "db:check": "node scripts/db-check.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
