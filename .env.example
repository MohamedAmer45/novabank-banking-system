# ============================================================
# NOVABANK ENVIRONMENT
# ============================================================

NODE_ENV=development

PORT=3000


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DATABASE_URL=

# false can be used for a local PostgreSQL instance.
# Hosted PostgreSQL normally requires SSL.
DATABASE_SSL=true


# ------------------------------------------------------------
# Authentication
#
# We will configure these during the JWT step.
# Never commit the real secrets.
# ------------------------------------------------------------

JWT_ACCESS_SECRET=

JWT_MFA_SECRET=

JWT_ACCESS_EXPIRY=8h
JWT_MFA_EXPIRY=5m
