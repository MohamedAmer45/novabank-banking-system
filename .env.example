# ============================================================
# NOVABANK ENVIRONMENT
# ============================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# PostgreSQL
#
# Any PostgreSQL 14+ connection string works: Neon, Supabase,
# a docker-compose service, or a CI service container.
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/novabank

# Set to false for a local/CI PostgreSQL without TLS.
DATABASE_SSL=true

DATABASE_POOL_MAX=10

# ------------------------------------------------------------
# QA mode
#
# When true the API echoes the values a test needs but a real
# bank would deliver out of band: the MFA code, the email
# verification code, the password-reset token and the
# beneficiary OTP. It also enables `qaSimulation` on transfers.
# Must be false for anything resembling production.
# ------------------------------------------------------------
QA_MODE=true
