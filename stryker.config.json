{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing over the units the Jest suite targets. See MUTATION.md for what the score means and what it deliberately does not.",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/security.js",
    "src/database.js",
    "src/lib/access.js",
    "src/lib/http.js",
    "src/banking.js"
  ],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "timeoutMS": 20000,
  "concurrency": 4
}
